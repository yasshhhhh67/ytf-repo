#!/bin/bash
# Runs as ytf-llm (through sudo). Reads a prompt on stdin, prints Antigravity's JSON result on stdout.
# Optional $1 = model name; only names on the allowlist below are accepted.
# The Antigravity login lives only in ytf-llm's keyring; nothing else on the system can read it.
set -euo pipefail
MODEL="${1:-}"
case "$MODEL" in
  ""|"Gemini 3.8 Flash (High)"|"Gemini 3.8 Flash (Medium)"|"Claude Sonnet 4.6 (Thinking)"|"Claude Opus 4.6 (Thinking)"|"GPT-OSS 120B (Medium)") ;;
  *) echo "model not allowed: $MODEL" >&2; exit 64 ;;
esac
PROMPT=$(cat)
WORK="$HOME/work"; mkdir -p "$WORK"; cd "$WORK"
exec dbus-run-session -- bash -c '
  eval "$(gnome-keyring-daemon --unlock --components=secrets < "$HOME/.keyring-pass")"
  export GNOME_KEYRING_CONTROL
  if [ -n "$2" ]; then set -- "$1" --model "$2"; else set -- "$1"; fi
  exec "$HOME/.local/bin/agy" --sandbox --print-timeout "540s" --output-format json "${@:2}" -p "$1"' _ "$PROMPT" "$MODEL"
